-- StealEgg.lua
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- Простое меню
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 200, 0, 250)
Frame.Position = UDim2.new(0, 50, 0, 50)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Active = true
Frame.Draggable = true

local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "Steal Egg Cheat"
Title.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
Title.TextColor3 = Color3.new(1,1,1)

-- Кнопка Auto Farm
local AutoBtn = Instance.new("TextButton", Frame)
AutoBtn.Size = UDim2.new(0.9, 0, 0, 40)
AutoBtn.Position = UDim2.new(0.05, 0, 0, 40)
AutoBtn.Text = "Auto Steal: OFF"
AutoBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
AutoBtn.TextColor3 = Color3.new(1,1,1)

getgenv().AutoSteal = false
AutoBtn.MouseButton1Click:Connect(function()
    getgenv().AutoSteal = not getgenv().AutoSteal
    AutoBtn.Text = "Auto Steal: " .. (getgenv().AutoSteal and "ON" or "OFF")
    
    while getgenv().AutoSteal do
        task.wait(0.1)
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name:lower():find("egg") and obj:IsA("BasePart") and getgenv().AutoSteal then
                    lp.Character.HumanoidRootPart.CFrame = obj.CFrame
                    firetouchinterest(lp.Character.HumanoidRootPart, obj, 0)
                    firetouchinterest(lp.Character.HumanoidRootPart, obj, 1)
                    task.wait(0.3)
                end
            end
        end)
    end
end)

-- Кнопка Speed
local SpeedBtn = Instance.new("TextButton", Frame)
SpeedBtn.Size = UDim2.new(0.9, 0, 0, 40)
SpeedBtn.Position = UDim2.new(0.05, 0, 0, 90)
SpeedBtn.Text = "Speed x3"
SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SpeedBtn.TextColor3 = Color3.new(1,1,1)
SpeedBtn.MouseButton1Click:Connect(function()
    lp.Character.Humanoid.WalkSpeed = 48
end)

-- Кнопка Jump
local JumpBtn = Instance.new("TextButton", Frame)
JumpBtn.Size = UDim2.new(0.9, 0, 0, 40)
JumpBtn.Position = UDim2.new(0.05, 0, 0, 140)
JumpBtn.Text = "High Jump"
JumpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
JumpBtn.TextColor3 = Color3.new(1,1,1)
JumpBtn.MouseButton1Click:Connect(function()
    lp.Character.Humanoid.JumpPower = 150
end)

-- ESP на яйца
local EspBtn = Instance.new("TextButton", Frame)
EspBtn.Size = UDim2.new(0.9, 0, 0, 40)
EspBtn.Position = UDim2.new(0.05, 0, 0, 190)
EspBtn.Text = "ESP Eggs"
EspBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
EspBtn.TextColor3 = Color3.new(1,1,1)
EspBtn.MouseButton1Click:Connect(function()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:lower():find("egg") and obj:IsA("BasePart") then
            local h = Instance.new("Highlight", obj)
            h.FillColor = Color3.fromRGB(255, 255, 0)
            h.OutlineColor = Color3.fromRGB(255, 0, 0)
        end
    end
end)

print("Steal Egg Cheat Loaded!")
